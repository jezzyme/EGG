# 이 파일을 .env.local 로 복사한 뒤 값을 채우면 해당 기능이 켜집니다.
# 자세한 설명은 DEPLOY.md 참고

# --- 구글 간편 로그인 ---
GOOGLE_CLIENT_ID=여기에-클라이언트-ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=여기에-보안-비밀번호

# --- 비밀번호 재설정 메일(선택) ---
# EGG_SMTP_HOST=smtp.gmail.com
# EGG_SMTP_PORT=587
# EGG_SMTP_USER=myaccount@gmail.com
# EGG_SMTP_PASSWORD=앱-비밀번호
# EGG_MAIL_FROM=no-reply@내도메인

# --- 데이터베이스(선택) ---
# 비워 두면 로컬 파일(egg.db)을 씁니다. 배포처의 PostgreSQL 을 로컬에서 시험할 때만 채우세요.
# EGG_DATABASE_URL=postgresql://user:pw@호스트/디비?sslmode=require

# --- 배포용(로컬에서는 비워 둡니다) ---
# EGG_ENV=production
# EGG_BASE_URL=https://내도메인
# EGG_ALLOWED_HOSTS=내도메인,www.내도메인
# EGG_SECRET_KEY=랜덤한-32바이트-16진수
